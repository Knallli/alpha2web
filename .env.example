# Copy to .env. Everything here can also be set on the Settings page;
# a variable set here wins and locks the field in the UI.

# Camera address (IP or hostname). Leave empty to find the camera automatically.
#CAMERA_HOST=192.168.1.50
# Camera MAC address, optional (speeds up the search)
#CAMERA_MAC=
#CAMERA_WAKE_ON_LAN=true          # send magic packets while disconnected (needs CAMERA_MAC)
#CAMERA_WAKE_ON_LAN_ADDR=255.255.255.255:9
#CAMERA_RECONNECT_INTERVAL=5s     # first retry delay, backs off up to 1 minute
# Access Authentication of the camera (SSH tunnel), optional
#CAMERA_USER=
#CAMERA_PASSWORD=
#CAMERA_FINGERPRINT=SHA256:...

# ---------------------------------------------------------------- Immich (plugin)
# Prefer the Settings page; a variable set here wins and locks the field.
#IMMICH_URL=http://192.168.1.10:2283
# Needs: asset.upload, album.read, album.create, albumAsset.create, stack.create
#IMMICH_API_KEY=
# Add every uploaded asset to this album (created if missing).
#IMMICH_ALBUM=
# Stack RAW+JPEG pairs in Immich (JPEG shown). Default: true
#IMMICH_STACK_RAW_JPEG=true

# ---------------------------------------------------------------- Immich behaviour
# Delete the local copy once Immich confirmed the upload. Default: true
#DELETE_AFTER_UPLOAD=true
# Also delete the shot from the camera card once it is in Immich. Irreversible. Default: false
#IMMICH_DELETE_ON_CAMERA=false
# Camera file extensions to ignore (comma separated, "none" ignores nothing).
#SKIP_EXTENSIONS=.XML,.THM
# Parallel uploads (downloads from the camera are always sequential).
#UPLOAD_CONCURRENCY=2
# Full re-listing of the cards while connected (safety net).
#RECONCILE_INTERVAL=10m
# Abort a download that makes no progress for this long.
#DOWNLOAD_STALL_TIMEOUT=3m
# Pause downloads when the staging volume has less free space than this.
#MIN_FREE_SPACE_MB=1024
# Retry backoff for failed downloads/uploads (exponential, capped).
#RETRY_BASE_DELAY=5s
#RETRY_MAX_DELAY=15m
# Where downloaded files wait for the upload (default: <DATA_DIR>/staging).
#STAGING_DIR=/staging

# Password for the whole web UI (HTTP basic auth, any user name). Set this.
#WEBUI_PASSWORD=
#HTTP_ADDR=:8765
#SHUTDOWN_TIMEOUT=20s
#LOG_LEVEL=info                   # debug, info, warn, error
#LOG_FORMAT=json                  # json or text
# /healthz, /health and /metrics stay open even with a password.
