# Copy to .env. Everything here can also be set on the Settings page;
# a variable set here wins and locks the field in the UI.

# Camera address (IP or hostname). Leave empty to find the camera automatically.
#CAMERA_HOST=192.168.1.50
# Camera MAC address, optional (speeds up the search)
#CAMERA_MAC=
#CAMERA_WAKE_ON_LAN=true          # send magic packets while disconnected (needs CAMERA_MAC)
#CAMERA_WAKE_ON_LAN_ADDR=255.255.255.255:9
#CAMERA_RECONNECT_INTERVAL=5s     # first retry delay, backs off up to 1 minute
# Access Authentication of the camera (SSH tunnel), optional
#CAMERA_USER=
#CAMERA_PASSWORD=
#CAMERA_FINGERPRINT=SHA256:...

# Password for the whole web UI (HTTP basic auth, any user name). Set this.
#WEBUI_PASSWORD=
#HTTP_ADDR=:8765
#SHUTDOWN_TIMEOUT=20s
#LOG_LEVEL=info                   # debug, info, warn, error
#LOG_FORMAT=json                  # json or text
# /healthz, /health and /metrics stay open even with a password.
